---
import textFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { site, socialLinks } from '../data/site';
const title = `${site.name} — ${site.title}`;
const url = 'https://najibninaba.com/';
const image = `${url}og.png`;
const person = {
	'@context': 'https://schema.org', '@type': 'Person', name: site.name,
	jobTitle: 'Head of Platforms Engineering',
	worksFor: [{ '@type': 'Organization', name: 'AI Singapore' }, { '@type': 'Organization', name: 'Nanyang Technological University' }],
	sameAs: socialLinks.map(link => link.href), url,
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		<title>{title}</title>
		<meta name="description" content={site.description} />
		<link rel="canonical" href={url} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={site.description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="Najib Ninaba: AI makes software cheaper to build, but not cheaper to own." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@najibninaba" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={site.description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content="Najib Ninaba: AI makes software cheaper to build, but not cheaper to own." />
		<meta name="color-scheme" content="light dark" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
		<script defer src="https://cloud.umami.is/script.js" data-website-id="6acd4b80-c735-46b8-b8dc-fd967a73d827"></script>
		<style is:inline set:html={`@font-face{font-family:Geist;src:url('${textFont}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap}@font-face{font-family:'Geist Mono';src:url('${monoFont}') format('woff2');font-style:normal;font-weight:100 900;font-display:swap}`} />
	</head>
	<body><a class="skip" href="#main">Skip to content</a><slot /></body>
</html>

<style is:global>
	:root {
		--paper: light-dark(#fcfcfb, #0f0f0e); --paper-2: light-dark(#f4f4f2, #181816);
		--ink: light-dark(#151515, #ececea); --ink-2: light-dark(#555552, #a8a8a4);
		--ink-3: light-dark(#6f6f6b, #8b8b87); --rule: light-dark(#e6e6e3, #242422);
		--accent: light-dark(#1a56c4, #8fb3ff); --sel: light-dark(#d9e5fb, #23365c);
		--underline-offset: .22em; color-scheme: light dark;
	}
	:root[data-theme='light'] { color-scheme: light; }
	:root[data-theme='dark'] { color-scheme: dark; }
	* { box-sizing: border-box; }
	html { background: var(--paper); scrollbar-color: var(--ink-3) var(--paper); }
	body { margin: 0; color: var(--ink); font-family: Geist, ui-sans-serif, system-ui, sans-serif; line-height: 1.5; -webkit-font-smoothing: antialiased; font-feature-settings: 'ss01'; }
	::selection { background: var(--sel); color: var(--ink); }
	a { color: inherit; text-decoration-color: color-mix(in oklab, var(--ink) 25%, transparent); text-underline-offset: var(--underline-offset); text-decoration-thickness: 1px; }
	a:hover { text-decoration-color: currentColor; }
	:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }
	button, summary { cursor: pointer; }
	button { font: inherit; color: inherit; background: none; }
	img { display: block; max-width: 100%; height: auto; }
	p, h1, h2, h3, figure { margin: 0; }
	[hidden] { display: none !important; }
	.mono { font-family: 'Geist Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
	.skip { position: absolute; left: 24px; top: -100px; padding: 8px 12px; background: var(--paper); z-index: 10; }
	.skip:focus { top: 12px; }
	@media (prefers-reduced-motion: no-preference) {
		.rise { animation: rise 700ms cubic-bezier(.16,1,.3,1) both; animation-delay: calc(var(--i, 0) * 70ms); }
		@keyframes rise { from { opacity: 0; transform: translateY(6px); filter: blur(3px); } to { opacity: 1; transform: none; filter: none; } }
	}
	@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>

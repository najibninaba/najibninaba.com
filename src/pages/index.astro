---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Bio from '../components/Bio.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import profile from '../assets/profile-enhanced.png';
import { site, intro, socialLinks } from '../data/site';
import { projects } from '../data/projects';
import { posts } from '../data/posts';
const sections = [ ['about', 'About'], ['projects', 'Projects'], ['writing', 'Writing'], ['experience', 'Experience'], ['bio', 'Bio'] ];
const latestPosts = [...posts].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const date = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Layout>
	<div class="frame">
		<aside class="rail rise">
			<div class="avatar"><Image src={profile} alt="" width={288} height={288} widths={[74, 96, 148, 192, 222, 288]} sizes="(max-width: 767px) 73px, 94px" format="webp" loading="eager" /></div>
			<nav aria-label="Sections">
				<ul>{sections.map(([id, label]) => <li><a href={`#${id}`}><span aria-hidden="true"></span>{label}</a></li>)}</ul>
			</nav>
			<div class="theme"><ThemeToggle /></div>
		</aside>
		<main id="main" tabindex="-1">
			<section id="about" aria-labelledby="name">
				<h1 id="name" class="rise" style="--i:1">{site.name}</h1>
				<p class="roles rise" style="--i:1">{site.title}</p>
				<div class="intro rise" style="--i:2">{intro.map(paragraph => <p>{paragraph}</p>)}</div>
			</section>
			<section id="projects" aria-labelledby="projects-heading">
				<h2 id="projects-heading">Projects</h2>
				<ul class="projects">
					{projects.map(project => <li>
						<div class="project-heading"><h3>{project.url ? <a href={project.url}>{project.name}</a> : project.name}</h3><span>{project.role} · {project.status}{project.license && ` · ${project.license}`}</span></div>
						<figure>
							<div class="preview"><Image src={project.thumbnail} alt={project.screenshotAlt} width={576} height={360} widths={[112, 192, 224, 336, 384, 576]} sizes="(max-width: 647px) 112px, (min-width: 768px) and (max-width: 879px) 112px, 192px" format="webp" fit="cover" position="top" loading="lazy" /></div>
							{(project.caption || project.captionLink) && <figcaption>{project.caption}{project.captionLink && <a href={project.captionUrl}>{project.captionLink}</a>}</figcaption>}
						</figure>
						<p class="project-description">{project.description} {project.url && project.details[0]}</p>
						{project.url && <p class="project-link"><a href={project.url}><span>{project.url.replace(/^https:\/\/(github\.com\/)?/, '')}</span><ArrowUpRight /></a></p>}
					</li>)}
				</ul>
			</section>
			<section id="writing" aria-labelledby="writing-heading">
				<h2 id="writing-heading">Writing</h2>
				<ul class="writing">{latestPosts.map(post => <li><a href={post.url}><time class="mono" datetime={post.date}>{date(post.date)}</time><span>{post.title}</span></a></li>)}</ul>
			</section>
			<section id="experience" aria-labelledby="experience-heading">
				<h2 id="experience-heading">Experience</h2>
				<ol class="experience">{site.experiences.map(item => <li><span class="mono period">{item.period}</span><div><p>{item.title}{item.org && <span class="org"> · {item.org}</span>}</p><p class="summary">{item.summary}</p></div></li>)}</ol>
			</section>
			<section id="bio" aria-labelledby="bio-heading"><h2 id="bio-heading">Bio</h2><Bio /></section>
			<footer><span>Singapore</span><nav aria-label="Elsewhere">{socialLinks.map(link => <a href={link.href}><span>{link.label}</span><ArrowUpRight /></a>)}</nav></footer>
		</main>
	</div>
	<script is:inline>
		(() => {
			const links = [...document.querySelectorAll('.rail nav a')];
			const sections = links.map(link => document.querySelector(link.getAttribute('href')));
			let pending = false;
			const update = () => {
				let active = sections[0];
				for (const section of sections) if (section.getBoundingClientRect().top <= innerHeight * .25) active = section;
				if (scrollY + innerHeight >= document.documentElement.scrollHeight - 2) active = sections.at(-1);
				links.forEach(link => {
					if (link.hash === `#${active.id}`) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				});
				pending = false;
			};
			const schedule = () => { if (!pending) { pending = true; requestAnimationFrame(update); } };
			addEventListener('scroll', schedule, { passive: true });
			addEventListener('resize', schedule);
			update();
		})();
	</script>
</Layout>
<style>
	.frame { display: grid; grid-template-columns: 168px minmax(0, 1fr); column-gap: 64px; max-width: 1040px; margin: 0 auto; padding: clamp(3rem, 11vh, 7.5rem) 24px 96px; }
	.rail { position: sticky; top: clamp(24px, 6vh, 56px); align-self: start; padding-top: 8px; }
	.avatar { width: 72px; height: 72px; overflow: hidden; border-radius: 50%; outline: 1px solid var(--rule); }
	.avatar img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transform: translateX(6%) scale(1.3); transform-origin: 50% 30%; }
	ul, ol { margin: 0; padding: 0; list-style: none; }
	.rail nav { margin-top: 40px; }
	.rail li + li { margin-top: 8px; }
	.rail a { display: flex; align-items: center; gap: 10px; min-height: 24px; font-size: 14px; color: var(--ink-3); text-decoration: none; transition: color 150ms; }
	.rail a:hover, .rail a[aria-current] { color: var(--ink); }
	.rail a span { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); opacity: 0; transform: scale(.4); transition: opacity 200ms, transform 200ms; }
	.rail a[aria-current] span { opacity: 1; transform: scale(1); }
	.theme { margin-top: 40px; }
	main { min-width: 0; max-width: 680px; }
	section { scroll-margin-top: 64px; }
	section + section { margin-top: 96px; }
	h1 { font-size: clamp(34px, 4.6vw, 48px); font-weight: 500; line-height: 1.08; letter-spacing: -.03em; text-wrap: balance; }
	.roles { margin-top: 16px; max-width: 52ch; font-size: 16px; line-height: 1.55; color: var(--ink-3); text-wrap: pretty; }
	.intro { display: grid; gap: 20px; margin-top: 40px; max-width: 60ch; font-size: 16px; line-height: 1.7; color: var(--ink-2); }
	h2 { margin-bottom: 24px; font-size: 13px; font-weight: 500; color: var(--ink-3); }
	.projects { display: grid; gap: 40px; container: projects / inline-size; }
	.projects li { display: grid; grid-template-columns: minmax(0, 1fr) 192px; column-gap: 24px; align-items: start; }
	.projects figure { grid-column: 2; grid-row: 1 / span 3; }
	.preview { overflow: hidden; border: 1px solid var(--rule); border-radius: 12px; background: var(--paper-2); }
	.preview img { display: block; width: 100%; aspect-ratio: 16/10; object-fit: cover; object-position: top; filter: brightness(var(--screenshot-brightness, 1)); transition: filter 200ms ease-out; }
	:global([data-theme='dark']) .projects { --screenshot-brightness: .88; }
	@media (prefers-color-scheme: dark) {
		:global(html:not([data-theme='light'])) .projects { --screenshot-brightness: .88; }
	}
	.projects li:hover .preview img, .projects li:focus-within .preview img { filter: brightness(1); }
	figcaption { margin-top: 8px; font-size: 13px; color: var(--ink-3); white-space: nowrap; }
	.project-heading { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; margin-top: -4px; }
	h3 { font-size: 18px; font-weight: 500; letter-spacing: -.015em; }
	h3 a { text-decoration: none; }
	.project-heading > span { color: var(--ink-3); font-size: 13px; }
	.project-description { grid-column: 1; grid-row: 2; margin-top: 8px; max-width: 60ch; color: var(--ink-2); font-size: 15.5px; line-height: 1.65; }
	.project-link { grid-column: 1; grid-row: 3; margin-top: 12px; color: var(--ink-2); font-size: 13px; }
	.project-link a { text-decoration-line: none; }
	.project-link a > span, footer a > span { text-decoration-line: underline; text-decoration-color: inherit; text-decoration-thickness: inherit; text-underline-offset: var(--underline-offset); }
	.writing li + li, .experience li + li { border-top: 1px solid var(--rule); }
	.writing a, .experience li { display: grid; grid-template-columns: 104px minmax(0, 1fr); column-gap: 16px; padding: 10px 0; font-size: 15.5px; }
	.writing a { text-decoration: none; margin-inline: -12px; padding-inline: 12px; border-radius: 6px; transition: background-color 160ms ease-out; }
	.writing a:hover, .writing a:focus-visible { background: var(--paper-2); }
	.writing time { transition: color 160ms ease-out; }
	.writing a:hover time, .writing a:focus-visible time { color: var(--ink-2); }
	.writing a:hover > span, .writing a:focus-visible > span { text-decoration: underline; text-decoration-color: var(--ink-3); text-underline-offset: var(--underline-offset); }
	time, .period { padding-top: 2px; font-size: 12.5px; color: var(--ink-3); }
	.period { white-space: nowrap; }
	.experience li { padding: 12px 0; line-height: 1.6; }
	.org, .summary { color: var(--ink-3); }
	.summary { margin-top: 2px; font-size: 14px; line-height: 1.55; }
	footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 96px; padding-top: 24px; border-top: 1px solid var(--rule); color: var(--ink-3); font-size: 13px; }
	footer nav { display: flex; gap: 20px; }
	footer a { text-decoration-line: none; min-height: 24px; }
	footer a:hover { color: var(--ink); }
	@media (max-width: 767px) {
		.frame { grid-template-columns: minmax(0, 1fr); row-gap: 40px; }
		.rail { position: static; display: flex; align-items: center; justify-content: space-between; padding-top: 0; }
		.avatar { width: 56px; height: 56px; }
		.rail nav { display: none; }
		.theme { margin-top: 0; }
	}
	@container projects (max-width: 599px) {
		.projects li { grid-template-columns: minmax(0, 1fr) 112px; column-gap: 16px; row-gap: 12px; }
		.projects figure { grid-column: 2; grid-row: 1; }
		.preview { border-radius: 8px; }
		figcaption { margin-top: 6px; font-size: 11px; letter-spacing: -.015em; }
		.project-description { grid-column: 1 / -1; grid-row: 2; margin-top: 0; }
		.project-link { grid-column: 1 / -1; grid-row: 3; margin-top: 0; }
	}
	@media (max-width: 420px) {
		.writing a, .experience li { grid-template-columns: 90px minmax(0, 1fr); column-gap: 14px; }
	}
</style>
